import { Modal, Form, Input, Select, Button, Radio, Upload, Space, Divider, Tag, message, Tooltip } from 'antd'
import { UploadOutlined, FolderOpenOutlined, FileTextOutlined, RobotOutlined, EyeOutlined, SearchOutlined, CheckOutlined, LinkOutlined } from '@ant-design/icons'
import { useEffect, useState } from 'react'
import { useTranslation } from 'react-i18next'
import { Item } from '../core/database'
import type { UploadProps } from 'antd'
import { autoRecognizeItem } from '../utils/autoRecognize'

interface ItemDialogProps {
  open: boolean
  onClose: () => void
  onSubmit: (data: {
    itemType: 'link' | 'file'
    title: string
    url: string
    category: string
    summary: string
    coverPath?: string
  }) => void
  item?: Item | null
  onGenerateSummary?: (url: string, itemType: 'link' | 'file') => Promise<string>
}

export default function ItemDialog({
  open,
  onClose,
  onSubmit,
  item,
  onGenerateSummary
}: ItemDialogProps) {
  const [form] = Form.useForm()
  const { t } = useTranslation()
  const [itemType, setItemType] = useState<'link' | 'file'>('link')
  const [summaryLoading, setSummaryLoading] = useState(false)
  const [showPreview, setShowPreview] = useState(false)
  const [recognizing, setRecognizing] = useState(false)
  const [coverPreview, setCoverPreview] = useState<string | null>(null)
  const [coverFile, setCoverFile] = useState<File | null>(null)
  const [coverType, setCoverType] = useState<'local' | 'preset'>('local')
  
  // Cropper state
  const [cropScale, setCropScale] = useState(1)
  const [cropPosition, setCropPosition] = useState({ x: 50, y: 50 }) // Start at center
  const [isDragging, setIsDragging] = useState(false)
  const [lastPosition, setLastPosition] = useState({ x: 0, y: 0 })
  const [isCropping, setIsCropping] = useState(false)
   
  // Helper function to convert File to base64 string
  const fileToBase64 = (file: File): Promise<string> => {
    return new Promise((resolve, reject) => {
      const reader = new FileReader()
      reader.readAsDataURL(file)
      reader.onload = () => resolve(reader.result as string)
      reader.onerror = (err) => reject(err)
    })
  }
  
  // Cropper event handlers
  const handleMouseDown = (e: React.MouseEvent<HTMLDivElement>) => {
    e.preventDefault()
    setIsDragging(true)
    setLastPosition({
      x: e.clientX,
      y: e.clientY
    })
  }

  const handleTouchStart = (e: React.TouchEvent<HTMLDivElement>) => {
    if (e.touches.length === 1) {
      setIsDragging(true)
      setLastPosition({
        x: e.touches[0].clientX,
        y: e.touches[0].clientY
      })
    }
  }

  // We need to add mouse move and up listeners to the window
  useEffect(() => {
    const handleMouseMove = (e: MouseEvent) => {
      if (!isDragging) return
      
      const dx = e.clientX - lastPosition.x
      const dy = e.clientY - lastPosition.y
      
      // Calculate percentage movement relative to container size
      const container = e.currentTarget as HTMLElement
      const rect = container.getBoundingClientRect()
      
      const moveX = (dx / rect.width) * 100
      const moveY = (dy / rect.height) * 100
      
      setCropPosition(prev => ({
        x: Math.max(0, Math.min(100, prev.x + moveX)),
        y: Math.max(0, Math.min(100, prev.y + moveY))
      }))
      
      setLastPosition({
        x: e.clientX,
        y: e.clientY
      })
    }

    const handleMouseUp = () => {
      setIsDragging(false)
    }

    const handleTouchMove = (e: TouchEvent) => {
      if (!isDragging || e.touches.length !== 1) return
      
      const dx = e.touches[0].clientX - lastPosition.x
      const dy = e.touches[0].clientY - lastPosition.y
      
      // Calculate percentage movement relative to container size
      // We need to get the container element - for simplicity, we'll use a fixed approach
      // In a real app, you might want to pass the container ref
      const containerWidth = 300 // Approximate width
      const containerHeight = 180 // Approximate height
      
      const moveX = (dx / containerWidth) * 100
      const moveY = (dy / containerHeight) * 100
      
      setCropPosition(prev => ({
        x: Math.max(0, Math.min(100, prev.x + moveX)),
        y: Math.max(0, Math.min(100, prev.y + moveY))
      }))
      
      setLastPosition({
        x: e.touches[0].clientX,
        y: e.touches[0].clientY
      })
    }

    const handleTouchEnd = () => {
      setIsDragging(false)
    }

    window.addEventListener('mousemove', handleMouseMove)
    window.addEventListener('mouseup', handleMouseUp)
    window.addEventListener('touchmove', handleTouchMove)
    window.addEventListener('touchend', handleTouchEnd)

    return () => {
      window.removeEventListener('mousemove', handleMouseMove)
      window.removeEventListener('mouseup', handleMouseUp)
      window.removeEventListener('touchmove', handleTouchMove)
      window.removeEventListener('touchend', handleTouchEnd)
    }
  }, [isDragging, lastPosition])

  // Update cover preview when crop settings change
  useEffect(() => {
    if (coverPreview) {
      setIsCropping(true)
    }
  }, [coverPreview, cropScale, cropPosition])
  
  const categories = [
    'Software', 'Programming', 'Design', 'Video', 
    'Music', 'Document', 'Image', 'Other'
  ]

  // Preset covers for different item types
  const presetCovers = [
    // Video type
    { label: t('preset_video'), value: 'linear-gradient(135deg, #ff0000 0%, #800080 100%)', type: 'video' },
    { label: t('preset_video_alt'), value: 'linear-gradient(135deg, #000000 0%, #424242 100%)', type: 'video' },
    // Image type
    { label: t('preset_image'), value: 'linear-gradient(135deg, #ff6b6b 0%, #4ecdc4 100%)', type: 'image' },
    { label: t('preset_image_alt'), value: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)', type: 'image' },
    // Music type
    { label: t('preset_music'), value: 'linear-gradient(135deg, #4a90e2 0%, #9013fe 100%)', type: 'music' },
    { label: t('preset_music_alt'), value: 'linear-gradient(135deg, #ffffff 0%, #f0f0f0 100%)', type: 'music' },
    // Document type
    { label: t('preset_document'), value: 'linear-gradient(135deg, #ffffff 0%, #f0f0f0 100%)', type: 'document' },
    { label: t('preset_document_alt'), value: 'linear-gradient(135deg, #2c3e50 0%, #4ca1af 100%)', type: 'document' },
    // Software/Programming type
    { label: t('preset_software'), value: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)', type: 'software' },
    { label: t('preset_programming'), value: 'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)', type: 'programming' },
    // Other type
    { label: t('preset_other'), value: 'linear-gradient(135deg, #8360c3 0%, #2ebf91 100%)', type: 'other' }
  ]

  // Helper function to get emoji for preset cover type
  const getPresetEmoji = (type: string): string => {
    switch (type) {
      case 'video': return '����';
      case 'image': return '�������';
      case 'music': return '����';
      case 'document': return '����';
      case 'software': return '����';
      case 'programming': return '����‍����';
      case 'other': return '����';
      default: return '';
    }
  }

  useEffect(() => {
    if (open) {
      // Delay to ensure Form is mounted
      setTimeout(() => {
        if (item) {
          setItemType(item.item_type)
          form.setFieldsValue({
            itemType: item.item_type,
            title: item.title || '',
            url: item.url || '',
            category: item.category || '',
            summary: item.summary || '',
            cover: item.cover_path || ''
          })
        } else {
          setItemType('link')
          form.resetFields()
          form.setFieldsValue({ cover: '' })
        }
      }, 100)
    }
  }, [open, item])

  const handleSubmit = async () => {
    try {
      const values = await form.validateFields()
      onSubmit({
        itemType: values.itemType,
        title: values.title,
        url: values.url,
        category: values.category || '',
        summary: values.summary || '',
        coverPath: values.cover || ''
      })
      onClose()
    } catch (err) {
      // Validation failed
    }
  }

  const handleAutoRecognize = async () => {
    const url = form.getFieldValue('url')
    if (!url) {
      message.warning(t('url_required'))
      return
    }

    setRecognizing(true)
    try {
      const { title, category, summary, urlOrPath, coverPath } = await autoRecognizeItem(url, itemType)
      // Update form fields with recognized data
      form.setFieldsValue({
        title: title || '',
        url: urlOrPath || url,
        category: category || '',
        summary: summary || '',
        cover: coverPath || ''   // Set the cover field
      })
      // Also update the coverPreview if we have a coverPath
      if (coverPath) {
        setCoverPreview(coverPath)
        setCoverFile(null)   // Because it's not a file, it's a URL
      }
      message.success(t('auto_recognize_success'))
    } catch (err) {
      console.error('Auto-recognition failed:', err)
      message.error(t('auto_recognize_failed'))
    } finally {
      setRecognizing(false)
    }
  }

  const handleGenerateSummary = async () => {
    const url = form.getFieldValue('url')
    if (!url) {
      message.warning(t('url_required'))
      return
    }

    if (!onGenerateSummary) {
      message.info(t('generate_summary_coming_soon'))
      return
    }

    setSummaryLoading(true)
    try {
      const summary = await onGenerateSummary(url, itemType)
      form.setFieldsValue({ summary })
      message.success(t('summary_generated'))
    } catch (err) {
      message.error(t('summary_generate_failed'))
    } finally {
      setSummaryLoading(false)
    }
  }

  const handleFileSelect = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files
    if (files && files.length > 0) {
      const file = files[0]
      form.setFieldsValue({
        url: file.name,
        title: file.name
      })
    }
  }

  const uploadProps: UploadProps = {
    beforeUpload: (file) => {
      form.setFieldsValue({
        url: file.name,
        title: file.name
      })
      return false
    },
    maxCount: 1,
  }

  const coverUploadProps: UploadProps = {
    beforeUpload: async (file) => {
      try {
        const base64 = await fileToBase64(file)
        setCoverPreview(base64)
        setCoverFile(file)
        // Also update the form field
        await form.setFieldsValue({ cover: base64 })
      } catch (err) {
        console.error('Failed to read cover file:', err)
        message.error(t('cover_upload_failed'))
      }
      return false
    },
    maxCount: 1,
  }

  const currentSummary = form.getFieldValue('summary') || ''

  return (
    <Modal
      title={item ? t('edit_item') : t('add_item')}
      open={open}
      onCancel={onClose}
      width={600}
      okText={t('save')}
      cancelText={t('cancel')}
      onOk={handleSubmit}
    >
      <Form form={form} layout="vertical" initialValues={{ itemType: 'link', cover: '' }}>
        <Form.Item
          name="itemType"
          label={t('item_type')}
        >
          <Radio.Group onChange={(e) => setItemType(e.target.value)}>
            <Radio.Button value="link"><LinkOutlined /> {t('type_link')}</Radio.Button>
            <Radio.Button value="file"><FolderOpenOutlined /> {t('type_file')}</Radio.Button>
          </Radio.Group>
        </Form.Item>

        <Form.Item
          name="url"
          label={t('item_url')}
          rules={[{ required: true, message: t('url_required') }]}
        >
          {itemType === 'link' ? (
            <Input 
              placeholder={t('url_placeholder')}
            />
          ) : (
            <Space.Compact style={{ width: '100%' }}>
              <Input 
                placeholder={t('file_path_placeholder')}
              />
              <Upload {...uploadProps}>
                <Button icon={<FolderOpenOutlined />}>
                  {t('select_file')}
                </Button>
              </Upload>
            </Space.Compact>
          )}
        </Form.Item>

        <Form.Item name="title" label={t('item_title')}>
          <Input placeholder={t('item_title_placeholder')} />
        </Form.Item>

        <Form.Item name="category" label={t('item_category')}>
          <Select
            placeholder={t('select_category')}
            allowClear
            options={categories.map(cat => ({
              label: t(`category_${cat.toLowerCase()}`) || cat,
              value: cat
            }))}
          />
        </Form.Item>

        <Divider>
          <FileTextOutlined /> {t('summary')}
          {currentSummary && (
            <Tag color="green" style={{ marginLeft: 8 }}>
              {t('has_summary')}
            </Tag>
          )}
        </Divider>

        <Form.Item name="summary" label={t('summary_content')}>
          <Input.TextArea 
            rows={5}
            placeholder={t('summary_placeholder')}
            showCount
            maxLength={2000}
          />
        </Form.Item>

        <Form.Item name="coverType" label={t('item_cover')}>
          <Radio.Group
            value={coverType}
            onChange={(e) => {
              setCoverType(e.target.value);
              if (e.target.value === 'local') {
                form.setFieldsValue({ cover: '' });
                setCoverPreview(null);
                setCoverFile(null);
              } else {
                // Keep current preset cover if any
                if (!form.getFieldValue('cover')) {
                  // Set default preset cover based on item type
                  const defaultCover = getDefaultPresetCover(itemType);
                  form.setFieldsValue({ cover: defaultCover });
                  setCoverPreview(defaultCover);
                }
              }
            }}
          >
            <Radio.Button value="local">{t('local_image')}</Radio.Button>
            <Radio.Button value="preset">{t('preset_cover')}</Radio.Button>
          </Radio.Group>
        </Form.Item>

        {/* Conditional cover selection */}
        {form.getFieldValue('coverType') === 'local' ? (
          <Form.Item style={{ marginTop: 16 }}>
            <Space.Compact style={{ width: '100%' }}>
              <Upload {...coverUploadProps}>
                <Button icon={<FileTextOutlined />}>
                  {t('select_cover')}
                </Button>
              </Upload>
              <div style={{ marginLeft: 8, fontSize: 12, color: '#999' }}>
                {t('cover_hint')}
              </div>
            </Space.Compact>
          </Form.Item>
        ) : (
          <Form.Item style={{ marginTop: 16 }}>
            <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
              {presetCovers.map((cover, index) => (
                <div
                  key={index}
                  style={{
                    width: 60,
                    height: 60,
                    border: form.getFieldValue('cover') === cover.value ? '2px solid #1890ff' : '1px dashed #d9d9d9',
                    borderRadius: 8,
                    background: cover.value.startsWith('linear-gradient') || cover.value.startsWith('radial-gradient') 
                      ? cover.value 
                      : `url(${cover.value})`,
                    backgroundSize: 'cover',
                    backgroundPosition: 'center',
                    backgroundRepeat: 'no-repeat',
                    cursor: 'pointer',
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    overflow: 'hidden'
                  }}
                  onClick={() => {
                    form.setFieldsValue({ cover: cover.value });
                    setCoverPreview(cover.value);
                  }}
                >
                  {form.getFieldValue('cover') === cover.value && (
                    <div style={{
                      position: 'absolute',
                      width: 60,
                      height: 60,
                      display: 'flex',
                      alignItems: 'center',
                      justifyContent: 'center',
                      background: 'rgba(0, 0, 0, 0.4)',
                      color: 'white',
                      fontSize: 14
                    }}>
                      <CheckOutlined />
                    </div>
                  )}
                  {form.getFieldValue('cover') !== cover.value && (
                    <div style={{
                      fontSize: 24,
                      textAlign: 'center',
                      width: '100%'
                    }}>
                      {getPresetEmoji(cover.type)}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </Form.Item>
        )}

        {/* Cover Preview with Crop Controls */}
        {coverPreview && (
          <>
            <Form.Item style={{ marginTop: 16 }}>
              <div 
                style={{ 
                  position: 'relative',
                  width: '100%', 
                  height: 180, 
                  borderRadius: 8, 
                  border: '1px dashed #d9d9d9',
                  overflow: 'hidden',
                  touchAction: 'none'
                }}
                onMouseDown={handleMouseDown}
                onTouchStart={handleTouchStart}
              >
                <div 
                  style={{ 
                    position: 'absolute',
                    top: 0,
                    left: 0,
                    width: '100%',
                    height: '100%',
                    background: coverPreview.startsWith('linear-gradient') || coverPreview.startsWith('radial-gradient') 
                      ? coverPreview 
                      : `url(${coverPreview})`,
                    backgroundSize: `${cropScale * 100}%`,
                    backgroundPosition: `${cropPosition.x}% ${cropPosition.y}%`,
                    backgroundRepeat: 'no-repeat',
                    transformOrigin: 'top left',
                    transition: 'transform 0.1s ease-out',
                    userSelect: 'none',
                    pointerEvents: 'none'
                  }}
                />
                
                {/* Crop overlay */}
                <div style={{
                  position: 'absolute',
                  top: 0,
                  left: 0,
                  width: '100%',
                  height: '100%',
                  background: 'rgba(0, 0, 0, 0.3)',
                  display: 'flex',
                  alignItems: 'center',
                  justifyContent: 'center'
                }}>
                  <div style={{
                    color: 'white',
                    fontSize: 16,
                    background: 'rgba(0, 0, 0, 0.5)',
                    padding: '8px 16px',
                    borderRadius: 4
                  }}>
                    {isCropping ? t('adjust_cover') : t('click_and_drag_to_move')}
                  </div>
                </div>
              </div>
              
              {/* Zoom controls */}
              <div style={{ 
                display: 'flex', 
                justifyContent: 'center', 
                alignItems: 'center', 
                gap: 8,
                marginTop: 8
              }}>
                <Button 
                  size="small"
                  onClick={() => setCropScale(Math.max(0.5, cropScale - 0.1))}
                >
                  <SearchOutlined /> Zoom Out
                </Button>
                <span style={{ fontSize: 12, color: '#666' }}>
                  {Math.round(cropScale * 100)}%
                </span>
                <Button 
                  size="small"
                  onClick={() => setCropScale(Math.min(3, cropScale + 0.1))}
                >
                  Zoom In <SearchOutlined />
                </Button>
              </div>
              
              {/* Reset button */}
              <div style={{ 
                textAlign: 'center', 
                marginTop: 4
              }}>
                <Button 
                  size="small"
                  type="text"
                  onClick={() => {
                    setCropScale(1);
                    setCropPosition({ x: 50, y: 50 });
                  }}
                >
                  {t('reset_view')}
                </Button>
              </div>
            </Form.Item>
          </>
        )}

        <Space>
          <Tooltip title={t('auto_recognize')}>
            <Button
              icon={<SearchOutlined />}
              onClick={handleAutoRecognize}
              loading={recognizing}
              disabled={itemType !== 'link'}
            >
              {t('auto_recognize')}
            </Button>
          </Tooltip>
          <Tooltip title={t('ai_coming_soon')}>
            <Button
              icon={<RobotOutlined />}
              onClick={handleGenerateSummary}
              loading={summaryLoading}
              disabled={true}
            >
              {t('generate_summary')}
            </Button>
          </Tooltip>
          {currentSummary && (
            <Button
              icon={<EyeOutlined />}
              onClick={() => setShowPreview(!showPreview)}
            >
              {showPreview ? t('hide_preview') : t('show_preview')}
            </Button>
          )}
        </Space>

        {showPreview && currentSummary && (
          <div
            style={{
              marginTop: 16,
              padding: 16,
              background: '#f5f5f5',
              borderRadius: 8,
              whiteSpace: 'pre-wrap',
              fontSize: 14,
              lineHeight: 1.8,
            }}
          >
            {currentSummary}
          </div>
        )}
      </Form>
    </Modal>
  )
}